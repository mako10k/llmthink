project LLMTHINK_SERVER_IMPLEMENTATION:
  version 7
  title "LLMThink hosted server implementation"
  description "Implement the proposed hosted-server design through a transport-independent Application Service, revision-aware server file repository, versioned REST API, Streamable HTTP MCP, preserved local adapters, and local Plugin/Skills acceptance. Production deployment, public Plugin submission, production OAuth configuration, database migration, refgraph-core or sealgraph adoption, MCP Apps UI, release, publication, remote writes, and unrelated llmthink changes remain outside this plan."
  as_of 2026-08-18
  duration_unit point
  finish SERVER_IMPLEMENTATION_ACCEPTED


milestone_acceptance_migration GRAMMAR_7_BASELINE:
  model 1
  repository git:sha1:5a9a3caff14f1bfa682f9e7ecd80f1553aa7f770:index:f56d15b714cf32d1442f806810ea4c4c665b23fa
