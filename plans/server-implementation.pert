project LLMTHINK_SERVER_IMPLEMENTATION:
  version 7
  title "LLMThink hosted server implementation"
  description "Implement the proposed hosted-server design through a transport-independent Application Service, revision-aware server file repository, versioned REST API, Streamable HTTP MCP, preserved local adapters, and local Plugin/Skills acceptance. Production deployment, public Plugin submission, production OAuth configuration, database migration, refgraph-core or sealgraph adoption, MCP Apps UI, release, publication, remote writes, and unrelated llmthink changes remain outside this plan."
  as_of 2026-08-18
  duration_unit point
  finish SERVER_IMPLEMENTATION_ACCEPTED


milestone_acceptance_migration GRAMMAR_7_BASELINE:
  model 1
  repository git:sha1:5a9a3caff14f1bfa682f9e7ecd80f1553aa7f770:index:f56d15b714cf32d1442f806810ea4c4c665b23fa
  path "plans/server-implementation.pert"
  object_format sha1
  head 5a9a3caff14f1bfa682f9e7ecd80f1553aa7f770
  blob f56d15b714cf32d1442f806810ea4c4c665b23fa
  source_digest sha256:cc6bace055e928703933e6e64338c0d5883e30ad97988d4c6581ac2e013ba046
  candidate_digest sha256:4b4c412b8d1344d9e8c5affa7679f39446e1f5209c46ccec402123bb10dfa45b
  grandfathered SERVER_DESIGN_AUDITED
resource CODEX:
  title "LLMThink server implementation capacity"
  capacity 1



milestone SERVER_FOUNDATION_IMPLEMENTED:
  title "Application Service and server file repository implemented"
  state reached

milestone HOSTED_ADAPTERS_IMPLEMENTED:
  title "REST API and Streamable HTTP MCP implemented"

milestone SERVER_SECURITY_ACCEPTED:
  title "Hosted identity authorization and observability accepted"

milestone SERVER_ACCEPTANCE_READY:
  title "Hosted server implementation ready for final local acceptance"

milestone SERVER_IMPLEMENTATION_ACCEPTED:
  title "Hosted server implementation accepted locally"




task IMPLEMENT_REST_API SERVER_FOUNDATION_IMPLEMENTED -> HOSTED_ADAPTERS_IMPLEMENTED:
  title "Implement the versioned REST JSON adapter"
  description "Add health and readiness endpoints plus the accepted /api/v1 audit, thought, draft, audit-record, finalize, reflection, event, list, and search routes. Validate all external input, map stable domain errors to fixed status and JSON envelopes, require expected revision and idempotency where specified, bound request and response sizes, and prove POST /audits does not persist. Keep deployment manifests and production authentication configuration out of scope."
  estimate:
    optimistic 2p
    most_likely 3p
    pessimistic 5p
  status done
  priority 90
  requires:
    CODEX 1
  source "docs/specs/server-architecture.md section 7"

task IMPLEMENT_STREAMABLE_HTTP_MCP SERVER_FOUNDATION_IMPLEMENTED -> HOSTED_ADAPTERS_IMPLEMENTED:
  title "Implement the Streamable HTTP MCP adapter"
  description "Expose /mcp with user-goal tools for pure audit, create draft, get, list, search, finalize, reflect, and history. Return structured machine-readable results with bounded text presentation; annotate read-only, write, and consequential-write effects; exclude delete; enforce RequestContext and server-side authorization; and test initialization, schema, invalid input, revision conflict, idempotency, confirmation, and disconnect behavior with MCP Inspector-compatible fixtures. Do not add custom UI."
  estimate:
    optimistic 2p
    most_likely 3p
    pessimistic 5p
  status done
  priority 90
  requires:
    CODEX 1
  source "ADR-0009; docs/specs/server-architecture.md section 8"

task PRESERVE_LOCAL_INTERFACES SERVER_FOUNDATION_IMPLEMENTED -> SERVER_ACCEPTANCE_READY:
  title "Preserve CLI stdio MCP and VSIX local behavior"
  description "Adapt existing CLI and stdio MCP paths to shared use cases where appropriate without requiring an HTTP server. Preserve .think and .dsl handling, workspace/user/system local storage behavior, existing stdio tool contract, audit presentation, thought lifecycle, LSP, preview, and VSIX behavior. Add parity regressions that distinguish the existing LocalFileThoughtStore contract from the new ServerFileThoughtStore safety contract."
  estimate:
    optimistic 1p
    most_likely 2p
    pessimistic 3p
  priority 80
  requires:
    CODEX 1
  source "ADR-0007; ADR-0008; ADR-0004"

task HARDEN_SERVER_BOUNDARIES HOSTED_ADAPTERS_IMPLEMENTED -> SERVER_SECURITY_ACCEPTED:
  title "Accept hosted identity authorization privacy and observability boundaries"
  description "Apply one authentication adapter boundary to REST and MCP; derive subject, tenant, workspace, and scopes only from verified context; reject non-loopback bind when authentication is disabled; enforce thought read, write, finalize, and audit scopes; redact tokens and thought bodies from logs; add request IDs, bounded metrics, rate and size limits, timeout handling, and negative cross-tenant tests. Test the production OAuth interface with fakes only and do not configure an external provider."
  estimate:
    optimistic 2p
    most_likely 3p
    pessimistic 5p
  priority 100
  requires:
    CODEX 1
  source "docs/specs/server-architecture.md sections 4,11-12; ADR-0009"

task ACCEPT_PLUGIN_AND_SKILLS SERVER_SECURITY_ACCEPTED -> SERVER_ACCEPTANCE_READY:
  title "Accept local Plugin metadata Skills and tool selection"
  description "Package local Plugin metadata and the llmthink-author, llmthink-auditor, and llmthink-reflector Skills against the accepted MCP tools. Verify Skills cannot widen scopes, bypass revision or confirmation, collect secrets, or change authorization outcomes. Run direct, indirect, follow-up, write-confirmation, unknown, and out-of-scope tool-selection evaluations. Use local or developer-mode testing only; do not deploy, submit, publish, or add MCP Apps UI."
  estimate:
    optimistic 1p
    most_likely 2p
    pessimistic 3p
  priority 70
  requires:
    CODEX 1
  source "docs/specs/server-architecture.md sections 9,12; ADR-0009"

task ACCEPT_SERVER_IMPLEMENTATION SERVER_ACCEPTANCE_READY -> SERVER_IMPLEMENTATION_ACCEPTED:
  title "Accept the hosted server implementation locally"
  description "Run perttool document validation, schedule and frontier checks, LLMThink design audit, focused Application Service and repository contract suites, path and concurrency fault tests, REST and MCP parity tests, authentication and privacy negatives, MCP Inspector checks, Plugin tool-selection evaluations, format, lint, typecheck, complete tests, build, examples, package dry run, generated-artifact review, and repository status review. Confirm production deployment, external OAuth configuration, DB or graph backend work, release, publication, remote writes, and public Plugin submission remain undone unless separately authorized."
  estimate:
    optimistic 1p
    most_likely 2p
    pessimistic 3p
  priority 100
  requires:
    CODEX 1
  source "docs/specs/server-architecture.md section 12; docs/process/server-architecture-review.think D6,D7"





milestone_criterion_set SERVER_FOUNDATION_R1:
  milestone SERVER_FOUNDATION_IMPLEMENTED
  revision R1
  commitment sha256:2844004e541ab190f6f3bdf50d5339e232250954fad61e0f4143da550250b7af
  criterion APPLICATION_USE_CASES required test "Direct use case tests prove pure audit is non-persistent, authorization is centralized, and allowed, denied, missing, revision-conflict, idempotent, and confirmation outcomes use stable domain results"
  criterion REPOSITORY_SAFETY required test "Repository tests prove validated identities, tenant isolation, immutable monotonic revisions, expected-revision conflicts, scoped idempotency, serialized writes, atomic CURRENT, fail-closed recovery, unsupported-schema rejection, and no cwd fallback"
  criterion TRANSPORT_INDEPENDENCE required artifact "Application Service depends only on Core and injected ports, imports no HTTP or MCP transport types, preserves Core audit meaning, and exposes no backend path as public identity"
  criterion FOUNDATION_REGRESSION required test "Focused foundation tests and complete tests, typecheck, lint, format check, build, examples, package dry run, PERT validation, and LLMThink audit pass"

