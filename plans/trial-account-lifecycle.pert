  criterion EXACT_REVISION_READBACK required artifact "Deployed revision and configuration are independently read back and match the frozen accepted candidate"
  criterion TERMS_AND_PROVISIONING required test "Exact terms consent idempotent provisioning re-consent recovery and export-only paths pass on the deployed endpoint"
  criterion TENANT_BOUNDARY required test "Cross-account and cross-tenant access fail closed on the deployed endpoint"
  criterion HEALTH_AND_ROLLBACK required artifact "Health evidence and a bounded rollback procedure are recorded without enabling general registration"

milestone_criterion_set PLUGIN_DISTRIBUTION_R1:
