milestone_criterion_set PARTICIPANT_OAUTH_ENTRY_R1:
  milestone PARTICIPANT_OAUTH_ENTRY_ACCEPTED
  revision R1
  commitment sha256:95eb0e7f123f2ca1127e5262baf367d7e91c4ff5c4ff9a85cbebabf5d6210e4b
  criterion NO_SHARED_OPERATOR_SECRET required test "Participant Plugin authenticates without receiving or reading the operator static bearer token"
  criterion CLIENT_INTEROP required test "Fresh supported client completes OAuth discovery authorization callback and MCP connection"
  criterion EXACT_IDENTITY_MAPPING required artifact "Exact WorkOS subject maps to one account and one tenant with no fallback identity"
  criterion REVOCATION_FAILS_CLOSED required test "Revocation and malformed or ambiguous identity are denied without cross-tenant disclosure"

