gate TERMS_COPY_BEFORE_ONBOARDING TERMS_COPY_APPROVED -> ONBOARDING_IMPLEMENTED:
  reason "The onboarding surface cannot be accepted before the exact user-facing terms and summary are approved"

gate OAUTH_BEFORE_ENROLLMENT_PACKAGE PARTICIPANT_OAUTH_ENTRY_ACCEPTED -> LIMITED_ENROLLMENT_PACKAGE_READY:
  reason "A participant must authenticate without receiving the operator static bearer token"

gate DEPLOYMENT_BEFORE_ENROLLMENT_PACKAGE DEPLOYED_LIFECYCLE_ALIGNED -> LIMITED_ENROLLMENT_PACKAGE_READY:
  reason "The accepted lifecycle must be the exact deployed and read-back candidate before enrollment approval"

gate DISTRIBUTION_BEFORE_ENROLLMENT_PACKAGE PLUGIN_DISTRIBUTION_AVAILABLE -> LIMITED_ENROLLMENT_PACKAGE_READY:
  reason "The exact accepted Plugin artifact must be privately obtainable and removable before enrollment approval"

gate LEGACY_ACCEPTANCE_BEFORE_ENROLLMENT_PACKAGE LEGACY_ACCEPTANCE_RECONCILED -> LIMITED_ENROLLMENT_PACKAGE_READY:
  reason "Previously reached lifecycle milestones must be backed by explicit criterion receipts rather than task closure alone"

