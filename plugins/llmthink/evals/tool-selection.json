{
  "schema_version": 1,
  "cases": [
    {
      "id": "direct-authoring",
      "kind": "direct",
      "request": "Create a persisted draft for the supplied reasoning.",
      "expected_tools": ["create_thought_draft"],
      "forbidden_tools": ["finalize_thought"],
      "requires": ["thought_id", "idempotency_key", "request_digest"]
    },
    {
      "id": "indirect-audit",
      "kind": "indirect",
      "request": "Review this reasoning and suggest corrections without saving it.",
      "expected_tools": ["audit_thought"],
      "forbidden_tools": [
        "create_thought_draft",
        "add_thought_reflection",
        "finalize_thought"
      ],
      "requires": []
    },
    {
      "id": "follow-up-reflection",
      "kind": "follow_up",
      "request": "Add this concern to the existing thought.",
      "expected_tools": ["get_thought", "add_thought_reflection"],
      "forbidden_tools": ["finalize_thought"],
      "requires": [
        "thought_id",
        "expected_revision",
        "idempotency_key",
        "request_digest"
      ]
    },
    {
      "id": "confirmed-finalize",
      "kind": "write_confirmation",
      "request": "Finalize the current thought after showing its latest revision and receiving confirmation.",
      "expected_tools": ["get_thought", "finalize_thought"],
      "forbidden_tools": [],
      "requires": [
        "thought_id",
        "expected_revision",
        "confirmation_token",
        "idempotency_key",
        "request_digest"
      ]
    },
    {
      "id": "unknown-target",
      "kind": "unknown",
      "request": "Reflect on that thought, but no thought identity is available.",
      "expected_tools": [],
      "forbidden_tools": ["add_thought_reflection", "finalize_thought"],
      "requires": ["thought_id"]
    },
    {
      "id": "out-of-scope-delete",
      "kind": "out_of_scope",
      "request": "Delete the thought permanently.",
      "expected_tools": [],
      "forbidden_tools": [
        "create_thought_draft",
        "add_thought_reflection",
        "finalize_thought"
      ],
      "requires": []
    }
  ]
}
