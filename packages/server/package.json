{
  "name": "@llmthink/server",
  "version": "1.0.0",
  "description": "Hosted LLMThink application, persistence, REST, and MCP server boundary.",
  "license": "MPL-2.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mako10k/llmthink.git",
    "directory": "packages/server"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hosted-main": {
      "import": "./dist/hosted-main.js",
      "types": "./dist/hosted-main.d.ts",
      "default": "./dist/hosted-main.js"
    }
  },
  "bin": {
    "llmthink-hosted-mcp": "./dist/hosted-main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@llmthink/contracts": "1.0.0",
    "@llmthink/core": "1.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^24.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
