{
  "name": "@llmthink/contracts",
  "version": "1.0.0",
  "description": "Versioned LLMThink interoperability artifacts and source-independent Conformance Kit.",
  "license": "MPL-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mako10k/llmthink.git",
    "directory": "packages/contracts"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts/*": "./contracts/*"
  },
  "bin": {
    "llmthink-contract": "./dist/cli.js"
  },
  "files": [
    "dist",
    "contracts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@llmthink/core": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
